<!-- Ported from GuiKeyboardSetupDialog.ui of PianoBooster (C++): same control names. The QGroupBox
     are borders with a title (as in SidePanel and MidiSetupDialog). GPLv3. -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PianoBooster.App.KeyboardSetupDialog"
        Title="Piano Keyboard Settings" Width="501" MaxWidth="501" Height="348" MinWidth="420" MinHeight="300"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
  <Window.Styles>
    <Style Selector="Border.group">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseMediumLowBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="TextBlock.groupTitle">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <DockPanel Margin="9">
    <!-- buttonBox: Ok | Cancel. As in the C++, Enter and Esc go to keyPressEvent (the piano), not to the buttons -->
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                Spacing="8" Margin="0,9,0,0">
      <Button x:Name="okButton" Content="OK" MinWidth="80"
              HorizontalContentAlignment="Center" Click="OnOkButtonClicked" />
      <Button x:Name="cancelButton" Content="Cancel" MinWidth="80"
              HorizontalContentAlignment="Center" Click="OnCancelButtonClicked" />
    </StackPanel>

    <Border Classes="group" x:Name="groupBox">
      <StackPanel Spacing="8">
        <TextBlock Classes="groupTitle" Text="Setup Your Piano Keyboard" />
        <!-- keyboardInfoText: a read-only QTextEdit, at most 60 high -->
        <Border BorderThickness="1" Background="White"
                BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}">
          <ScrollViewer Height="60" HorizontalScrollBarVisibility="Disabled">
            <SelectableTextBlock x:Name="keyboardInfoText" TextWrapping="Wrap" Margin="4" Foreground="Black" />
          </ScrollViewer>
        </Border>

        <Grid ColumnDefinitions="*,6,*">
          <Border Classes="group" x:Name="groupBox_3">
            <StackPanel>
              <TextBlock Classes="groupTitle" Text="Right Notes" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock x:Name="label_4" Classes="label" Text="sound:" />
                <ComboBox x:Name="rightSoundCombo" Grid.Column="1" MinWidth="150" HorizontalAlignment="Stretch"
                          MaxDropDownHeight="400" SelectionChanged="OnRightSoundComboActivated" />
                <TextBlock x:Name="rightVolumeLabel" Classes="label" Grid.Row="1" Text="volume:" />
                <DockPanel Grid.Row="1" Grid.Column="1">
                  <Button x:Name="rightTestButton" DockPanel.Dock="Right" Content="Test" MinWidth="60"
                          HorizontalContentAlignment="Center" />
                  <NumericUpDown x:Name="rightVolumeSpin" Minimum="1" Maximum="200" Value="100"
                                 FormatString="0'%'" ParsingNumberStyle="Integer" HorizontalAlignment="Left" />
                </DockPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="group" x:Name="groupBox_2" Grid.Column="2">
            <StackPanel>
              <TextBlock Classes="groupTitle" Text="Wrong Notes" />
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="6" RowSpacing="6">
                <TextBlock x:Name="label" Classes="label" Text="sound:" />
                <ComboBox x:Name="wrongSoundCombo" Grid.Column="1" MinWidth="150" HorizontalAlignment="Stretch"
                          MaxDropDownHeight="400" SelectionChanged="OnWrongSoundComboActivated" />
                <TextBlock x:Name="wrongVolumeLabel" Classes="label" Grid.Row="1" Text="volume:" />
                <DockPanel Grid.Row="1" Grid.Column="1">
                  <Button x:Name="wrongTestButton" DockPanel.Dock="Right" Content="Test" MinWidth="60"
                          HorizontalContentAlignment="Center" />
                  <NumericUpDown x:Name="wrongVolumeSpin" Minimum="1" Maximum="200" Value="100"
                                 FormatString="0'%'" ParsingNumberStyle="Integer" HorizontalAlignment="Left" />
                </DockPanel>
              </Grid>
            </StackPanel>
          </Border>
        </Grid>

        <Border Classes="group" x:Name="groupBox_4">
          <StackPanel>
            <TextBlock Classes="groupTitle" Text="Keyboard Note Range" />
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,*,Auto" ColumnSpacing="6">
              <TextBlock x:Name="label_6" Classes="label" Text="Lowest Note:" />
              <TextBox x:Name="lowestNoteEdit" Grid.Column="1" Width="60" MaxLength="3"
                       ToolTip.Tip="The note number between 0 and 127" />
              <TextBlock x:Name="label_7" Classes="label" Grid.Column="3" Text="Highest Note:" />
              <TextBox x:Name="highestNoteEdit" Grid.Column="4" Width="60" MaxLength="3"
                       ToolTip.Tip="The note number between 0 and 127" />
              <Button x:Name="resetButton" Grid.Column="6" Content="Reset" MinWidth="80"
                      HorizontalContentAlignment="Center" Click="OnResetButtonClicked" />
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </DockPanel>
</Window>
